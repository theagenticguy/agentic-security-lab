# Normalize line endings on checkin, auto-detect text
* text=auto eol=lf

# Explicit text types
*.py    text
*.toml  text
*.yml   text
*.yaml  text
*.json  text
*.md    text
*.mdx   text
*.ts    text
*.tsx   text
*.js    text
*.mjs   text

# Binary assets (never normalize)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# Lockfiles: keep as-is, mark generated
uv.lock        linguist-generated=true
pnpm-lock.yaml linguist-generated=true
